---
import { STACK } from "@/data/stack";
---

<ul class="stack">
  {
    STACK.map(({ icon: TeckIcon, label }) => (
      <li>
        <TeckIcon class="icon" width={15} height={15} fill="currentColor" aria-hidden="true" />
        {label}
      </li>
    ))
  }
</ul>

<style>
  .stack {
    list-style: none;
    margin: clamp(1.6rem, 3.5vw, 2.1rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .stack li {
    display: flex;
    align-items: center;
    gap: 0.42rem;
  }
  .stack .icon {
    color: var(--dim);
  }
</style>
