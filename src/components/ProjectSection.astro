---
import type { PublishedProject } from "@/data/types";
import type { Lang } from "@/i18n/lang";
import { useTranslations } from "@/i18n/utils";
import CodeFigure from "./CodeFigure.astro";

interface Props {
  lang: Lang;
  project: PublishedProject;
  version: string | null;
}

const { lang, project, version }: Props = Astro.props;
const t = useTranslations(lang);

type Row = { term: string; value: string; cls?: string };
const rows: Row[] = [];

if (version) {
  rows.push({ term: t("meta.version"), value: version });
}

rows.push({
  term: t("meta.status"),
  value: t(`status.${project.status}`),
  cls: `status ${project.status}`,
});

if (project.kind === "mobile-app") {
  rows.push({ term: t("meta.platform"), value: project.platform });
}
if (project.kind === "python-lib") {
  rows.push({ term: t("meta.python"), value: project.python });
}
if (project.kind === "npm-lib") {
  rows.push({ term: t("meta.packages"), value: String(project.packages.length) });
}

rows.push({ term: t("meta.license"), value: project.license });
---

<section class="project" id={project.id}>
  <div class="project-meta">
    <h2><a href={project.home}>{project.name}</a></h2>

    <!-- side meta -->
    <dl>
      {
        rows.map((row) => [
          <dt>{row.term}</dt>,
          <dd>{row.cls ? <b class={row.cls}>{row.value}</b> : row.value}</dd>,
        ])
      }
    </dl>

    <!-- side links -->
    <ul>
      {
        project.links.map((link) => (
          <li>
            <a href={link.href}>{link.label[lang]}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="project-body">
    {project.body[lang].map((html) => <p set:html={html} />)}

    {
      project.figures.map((figure) =>
        figure.type === "code" ? (
          <CodeFigure caption={figure.caption} lang={figure.lang} code={figure.code} />
        ) : (
          <figure>
            <img
              src={figure.src}
              width={figure.width}
              height={figure.height}
              alt={figure.alt[lang]}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ),
      )
    }

    {
      project.kind === "npm-lib" && (
        <ul class="packages">
          {project.packages.map((pkg) => (
            <li>
              <code>{pkg.href ? <a href={pkg.href}>{pkg.name}</a> : pkg.name}</code>
              <span>{pkg.desc[lang]}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      "install" in project && (
        <div class="install">
          <code>{project.install}</code>
          <button
            class="copy"
            type="button"
            data-copy={project.install}
            data-done={t("action.copied")}
          >
            {t("action.copy")}
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy").forEach((button) => {
    const label = button.textContent;

    button.addEventListener("click", async () => {
      const text = button.dataset.copy;
      if (!text) return;

      await navigator.clipboard.writeText(text);
      button.textContent = button.dataset.done ?? label;
      button.classList.add("done");

      setTimeout(() => {
        button.textContent = label;
        button.classList.remove("done");
      }, 1200);
    });
  });
</script>

<style>
  .project {
    padding: clamp(3rem, 6vw, 4.25rem) 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 2.25rem;
  }
  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  h2 {
    margin: 0 0 0.35rem;
    font-family: var(--mono);
    font-weight: 500;
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
    line-height: 1.35;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  /* ---- meta (左カラム) ---- */
  .project-meta {
    font-size: var(--fs-sm);
    line-height: 1.9;
    color: var(--muted);
  }
  .project-meta dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.9rem;
  }
  .project-meta dt {
    color: var(--dim);
    font-family: var(--mono);
    font-size: var(--fs-xs);
  }
  .project-meta dd {
    margin: 0;
  }
  .status {
    font-weight: 500;
  }
  .status.stable {
    color: var(--ok);
  }
  .status.wip {
    color: var(--warn);
  }
  .project-meta ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .project-meta ul a {
    text-decoration: none;
  }
  .project-meta ul a:hover {
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .project-meta dl {
      grid-template-columns: auto auto;
      justify-content: start;
      column-gap: 1.2rem;
    }
    .project-meta ul {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
      margin-top: 0.6rem;
    }
  }

  /* ---- body (右カラム) ---- */
  .project-body p {
    margin: 0 0 1rem;
  }
  /* <p> の中身は set:html なのでスコープ属性が付かない。:global が要る。 */
  .project-body p :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
  .project-body p :global(code) {
    font-family: var(--mono);
    font-size: var(--fs-md);
    background: var(--code);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  /* スクリーンショット */
  figure img {
    border: 1px solid var(--rule);
    border-radius: 5px;
    background: var(--code);
  }

  /* ---- install ---- */
  .install {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    font-family: var(--mono);
    font-size: var(--fs-sm);
    font-feature-settings: normal;
  }
  .install code {
    font-family: var(--mono);
    font-size: 1em;
    background: var(--code);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.34rem 0.6rem;
  }
  .install code::before {
    content: "$ ";
    color: var(--dim);
  }
  .copy {
    font: inherit;
    font-size: var(--fs-xs);
    background: none;
    border: 0;
    padding: 0.1rem;
    color: var(--dim);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .copy:hover {
    color: var(--text);
  }
  .copy.done {
    color: var(--ok);
    text-decoration: none;
  }

  /* ---- sub packages ---- */
  .packages {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-lg);
    max-width: 36rem;
  }
  .packages li {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 0.1rem 1rem;
    padding: 0.4rem 0;
    border-top: 1px dotted var(--rule2);
    align-items: baseline;
  }
  .packages li:first-child {
    border-top: 0;
  }
  .packages code {
    font-family: var(--mono);
    font-size: var(--fs-sm);
  }
  .packages span {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .packages li {
      grid-template-columns: 1fr;
    }
  }
</style>
