{
  "name": "tsutsu3.github.io",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "eslint",
    "format": "prettier --write .",
    "preview:cf": "pnpm build && wrangler dev --env dev",
    "deploy:prd": "wrangler deploy --env prd",
    "deploy:dev": "wrangler deploy --env dev",
    "delete:dev": "wrangler delete --env dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.165.0"
  }
}
